{
  "name": "skyray-holidays-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/web", "apps/api", "apps/mobile"],
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "scripts": {
    "dev:web": "npm --workspace @skyray/web run dev",
    "dev:api": "npm --workspace @skyray/api run start:dev",
    "dev:mobile": "npm --workspace @skyray/mobile run start",
    "build:web": "npm --workspace @skyray/web run build",
    "build:api": "npm --workspace @skyray/api run build",
    "start:api": "node apps/api/dist/src/main.js",
    "typecheck:web": "npm --workspace @skyray/web exec tsc -- --noEmit",
    "typecheck:api": "npm --workspace @skyray/api exec tsc -- --noEmit",
    "typecheck:mobile": "npm --workspace @skyray/mobile exec tsc -- --noEmit",
    "db:generate": "npm --workspace @skyray/api run prisma:generate",
    "db:migrate": "npm --workspace @skyray/api run prisma:migrate",
    "db:seed": "npm --workspace @skyray/api run prisma:seed"
  }
}
