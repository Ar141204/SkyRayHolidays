.expo-shared/
apps/mobile/.expo-shared/
web-build/
*.apk
*.aab
*.ipa
*.xcarchive/

# TypeScript & Compiler build caches
dist/
apps/api/dist/
build/
*.tsbuildinfo
tsconfig.tsbuildinfo

# Environment configurations & secret keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
apps/web/.env.local
apps/web/.env.*.local
apps/mobile/.env
apps/mobile/.env.*
