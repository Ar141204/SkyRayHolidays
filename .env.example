# Shared
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Database
POSTGRES_DB=skyray
POSTGRES_USER=skyray
POSTGRES_PASSWORD=change-this-long-password
DATABASE_URL=postgresql://skyray:change-this-long-password@localhost:5432/skyray?schema=public

# API auth: generate with `openssl rand -base64 48`
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false

# Admin seed (optional; only create a staff user if all values are set)
SEED_ADMIN_NAME=SkyRay Owner
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ENQUIRY_NOTIFICATION_EMAIL=

# Microsoft Graph delegated OAuth + Excel Online
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:4000/api/v1/integrations/microsoft/callback
MS_TOKEN_ENCRYPTION_KEY=
MS_DRIVE_ID=
MS_WORKBOOK_ITEM_ID=
MS_TABLE_NAME=Enquiries

# Google Places API (server only)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_REVIEWS_URL=

# Mobile app API URL (use LAN IP for physical devices)
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
