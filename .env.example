# ==========================================
# SkyRay Holidays Platform - Environment Config
# ==========================================

# 1. Core / Hosting URLs
NODE_ENV=production
APP_URL=https://skyrayholidays.com
API_URL=https://api.skyrayholidays.com/api/v1
CORS_ORIGINS=https://skyrayholidays.com,http://localhost:3000,http://localhost:8081

# 2. Database (Supabase Cloud PostgreSQL)
# Transaction Pooler URL (port 6543, pgbouncer=true) for runtime application queries:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct Session URL (port 5432) for Prisma migrations and schema push:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 3. API Authentication & Security (generate with: openssl rand -base64 48)
JWT_SECRET=replace-with-at-least-32-random-characters-secret
JWT_EXPIRES_IN=8h
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TRUST_PROXY=true

# 4. Initial Admin Account (Seeded on first deployment)
SEED_ADMIN_NAME="Syed Rahamathullah"
SEED_ADMIN_EMAIL=syedrahamathullah@skyrayholidays.com
SEED_ADMIN_PASSWORD=SkyRayAdmin2026!Secure

# 5. Email Notifications (SMTP)
# Common hosts:
# - Gmail / Google Workspace: smtp.gmail.com (Port 587, Secure false)
# - Zoho Mail: smtp.zoho.in (Port 465, Secure true) or smtppro.zoho.in
# - Hostinger: smtp.hostinger.com (Port 465, Secure true)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=syedrahamathullah@skyrayholidays.com
SMTP_PASSWORD=
SMTP_FROM=syedrahamathullah@skyrayholidays.com
ENQUIRY_NOTIFICATION_EMAIL=syedrahamathullah@skyrayholidays.com

# 5b. Customer Return / Auto-Reply Email (Sent from separate email to prevent spamming business "Sent" mail)
CUSTOMER_SMTP_HOST=smtp.gmail.com
CUSTOMER_SMTP_PORT=465
CUSTOMER_SMTP_SECURE=true
CUSTOMER_SMTP_USER=skyrayholidays@gmail.com
CUSTOMER_SMTP_PASSWORD=
CUSTOMER_SMTP_FROM="SkyRay Holidays" <skyrayholidays@gmail.com>
ENABLE_CUSTOMER_AUTO_REPLY=true

# 6. Optional External Integrations
MS_TENANT_ID=common
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://api.skyrayholidays.com/api/v1/integrations/microsoft/callback
MS_TOKEN_ENCRYPTION_KEY=32_byte_hex_encryption_key_for_oauth_tokens_here
MS_DRIVE_ID=
MS_WORKBOOK_ITEM_ID=
MS_TABLE_NAME=Enquiries
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_REVIEWS_URL=

# 7. Mobile App API URL
EXPO_PUBLIC_API_URL=https://api.skyrayholidays.com/api/v1
